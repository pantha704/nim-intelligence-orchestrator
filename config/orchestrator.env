ROUTER_BASE_URL=http://127.0.0.1:4000/v1
ROUTER_API_KEY_FILE=~/.config/opencode/nim-router/master.key

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=4010

MODELS_FAST=deepseek-v4-flash
MODELS_GENERAL=glm-5.2
MODELS_REASONING=deepseek-v4-pro
MODELS_LONG_CONTEXT=minimax-3

CANDIDATE_COUNT=5
DEBATE_ROUNDS=2
REFINE_ROUNDS=2
JUDGE_MODEL=deepseek-v4-pro
SYNTHESIS_MODEL=deepseek-v4-pro

VERIFIER_TIMEOUT=30
MAX_REPAIR_ROUNDS=2
